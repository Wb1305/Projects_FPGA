initial 
	begin
		TS=0; TL=0; C=0; reset=1;
		clk=0;
		#100; TS=0; TL=1; C=1; reset=0;
		#100; TS=0; TL=0; C=0; reset=1;
		#100; TS=1; TL=1; C=0; reset=0;
